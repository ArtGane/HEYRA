{
  "manifest_version": 3,
  "name": "URL Fetcher",
  "version": "1.0",
  "description": "Récupère l'URL de la page active.",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}